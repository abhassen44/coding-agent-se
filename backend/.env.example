# ── Core ───────────────────────────────────────────────────────────
APP_NAME=Intelligent Coding Agent
DEBUG=false
ENVIRONMENT=development
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true

# ── Database / cache / vectors ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ica
REDIS_URL=redis://127.0.0.1:6380
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=ica_code_chunks

# ── Auth ───────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
PREVIEW_TOKEN_EXPIRE_MINUTES=10

# One-time admin bootstrap. Set both values, register/login, then disable.
ADMIN_EMAIL=
ALLOW_ADMIN_BOOTSTRAP=false

# ── Models ─────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3-flash-preview
HF_API_TOKEN=
GITHUB_TOKEN=

# ── Workspaces / execution ─────────────────────────────────────────
WORKSPACE_BASE_IMAGE=node:20-bookworm
WORKSPACE_MEMORY_LIMIT=512m
WORKSPACE_CPU_QUOTA=100000
MAX_WORKSPACES_PER_USER=1
MAX_WORKSPACES_GLOBAL=2
PREVIEW_BIND_HOST=127.0.0.1
PREVIEW_CONNECT_HOST=127.0.0.1
EXECUTION_TIMEOUT=10
EXECUTION_MEMORY_LIMIT=256m
EXECUTION_CPU_QUOTA=50000

# ── Storage ────────────────────────────────────────────────────────
FILE_STORAGE_PATH=./storage/files
